{
	"author": "r37r0m0d3l@proton.me",
	"bin": {
		"2adoc": "./bin/cli.js"
	},
	"bugs": {
		"url": "https://github.com/r37r0m0d3l/2adoc/issues"
	},
	"dependencies": {
		"@asciidoctor/core": "4.0.6",
		"csv-parse": "7.0.1",
		"fast-xml-parser": "5.10.1",
		"js-yaml": "5.2.3",
		"mammoth": "1.12.0",
		"pdf-parse": "2.4.5",
		"smol-toml": "1.7.1",
		"turndown": "7.2.4",
		"xlsx": "0.18.5"
	},
	"description": "Universal CLI tool to convert document & data formats into canonical AsciiDoc (.adoc)",
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/js-yaml": "4.0.9",
		"@types/node": "26.0.1",
		"@types/turndown": "5.0.6",
		"esbuild": "0.28.1",
		"typescript": "7.0.2"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"bin"
	],
	"homepage": "https://github.com/r37r0m0d3l/2adoc#readme",
	"keywords": [
		"asciidoc",
		"adoc",
		"pandoc",
		"converter",
		"docx-to-asciidoc",
		"markdown-to-asciidoc",
		"pdf",
		"cli",
		"rag-ingestion",
		"llm-context"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"name": "2adoc",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r37r0m0d3l/2adoc.git"
	},
	"scripts": {
		"build": "npm run type-check && npm run lint && npm run build:types && npm run build:js",
		"build:js": "esbuild src/index.ts --bundle --platform=node --format=esm --target=es2024 --minify --sourcemap --outdir=dist --packages=external && esbuild src/cli.ts --bundle --platform=node --format=esm --target=es2024 --minify --sourcemap --outdir=bin --packages=external",
		"build:types": "tsc -p tsconfig.build.json",
		"type-check": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepublishOnly": "npm run build",
		"test": "node --test test/**/*.test.js"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "1.0.0"
}
