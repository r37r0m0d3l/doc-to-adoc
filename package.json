{
	"author": "r37r0m0d3l@proton.me",
	"bin": {
		"doc-to-adoc": "./bin/cli.js"
	},
	"bugs": {
		"url": "https://github.com/r37r0m0d3l/doc-to-adoc/issues"
	},
	"dependencies": {
		"@asciidoctor/core": "4.0.6",
		"csv-parse": "7.0.1",
		"exceljs": "^4.4.0",
		"fast-xml-parser": "5.10.1",
		"js-yaml": "5.2.3",
		"mammoth": "1.12.0",
		"pandoc-binary": "^2.14.0",
		"pdf-parse": "2.4.5",
		"smol-toml": "1.7.1",
		"tesseract.js": "^7.0.0",
		"turndown": "7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"word-extractor": "^1.0.4",
		"xlsx": "0.18.5"
	},
	"description": "Universal CLI tool to convert document & data formats into canonical AsciiDoc (.adoc)",
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/js-yaml": "4.0.9",
		"@types/node": "26.0.1",
		"@types/turndown": "5.0.6",
		"esbuild": "0.28.1",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=23.0.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"bin",
		"dist",
		"llms-full.txt",
		"llms.txt"
	],
	"homepage": "https://github.com/r37r0m0d3l/doc-to-adoc#readme",
	"keywords": [
		"asciidoc",
		"adoc",
		"document-converter",
		"cli",
		"converter",
		"csv-to-asciidoc",
		"data-extraction",
		"doc-to-asciidoc",
		"document-processor",
		"docx",
		"docx-to-asciidoc",
		"excel",
		"html-to-asciidoc",
		"json-to-asciidoc",
		"llm",
		"llm-context",
		"markdown",
		"markdown-to-asciidoc",
		"ocr",
		"pandoc",
		"pdf",
		"pdf-to-asciidoc",
		"rag",
		"rag-ingestion",
		"structured-data",
		"technical-writing",
		"tesseract",
		"text-extraction",
		"xlsx-to-asciidoc",
		"xml-to-asciidoc"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"name": "doc-to-adoc",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r37r0m0d3l/doc-to-adoc.git"
	},
	"scripts": {
		"build": "npm run type-check && npm run lint && npm run build:types && npm run build:js",
		"build:docs": "npx downdoc README.adoc -o README.md",
		"build:js": "esbuild src/index.ts --bundle --platform=node --format=esm --target=es2024 --minify --sourcemap --outdir=dist --packages=external && esbuild src/cli.ts --bundle --platform=node --format=esm --target=es2024 --minify --sourcemap --outdir=bin --packages=external",
		"build:types": "tsc -p tsconfig.build.json",
		"pretest": "npm run build:types && npm run build:js",
		"type-check": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepublishOnly": "npm run build",
		"test": "node --test test/cli/*.test.js test/npm/*.test.js",
		"test:cli": "node --test test/cli/*.test.js",
		"test:npm": "node --test test/npm/*.test.js"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "1.1.1"
}
